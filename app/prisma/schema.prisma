generator client {
  provider      = "prisma-client-js"
  output        = "/home/ubuntu/writers_corner/app/node_modules/.prisma/client"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  User              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Comment {
  id                 String             @id
  content            String
  userId             String
  submissionId       String
  createdAt          DateTime           @default(now())
  updatedAt          DateTime
  ExerciseSubmission ExerciseSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  User               User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}

model CommunityPost {
  id         String   @id
  title      String
  content    String
  userId     String
  exerciseId String?
  isPublic   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime
  User       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Exercise {
  id                 String               @id
  title              String
  prompt             String
  instructions       String
  topicId            String
  order              Int                  @default(0)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime
  WritingTopic       WritingTopic         @relation(fields: [topicId], references: [id], onDelete: Cascade)
  ExerciseSubmission ExerciseSubmission[]
}

model ExerciseSubmission {
  id         String    @id
  content    String
  userId     String
  exerciseId String
  isPublic   Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime
  Comment    Comment[]
  Exercise   Exercise  @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  User       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  Like       Like[]

  @@unique([userId, exerciseId])
}

model Like {
  id                 String             @id
  userId             String
  submissionId       String
  createdAt          DateTime           @default(now())
  ExerciseSubmission ExerciseSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  User               User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, submissionId])
  @@index([submissionId])
}

model Milestone {
  id           String         @id
  title        String
  description  String
  week         Int
  order        Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime
  UserProgress UserProgress[]
}

model Session {
  id           String   @id
  sessionToken String   @unique
  userId       String
  expires      DateTime
  User         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                 String               @id
  name               String?
  firstName          String?
  lastName           String?
  email              String               @unique
  emailVerified      DateTime?
  image              String?
  password           String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime
  Account            Account[]
  Comment            Comment[]
  CommunityPost      CommunityPost[]
  ExerciseSubmission ExerciseSubmission[]
  Like               Like[]
  Session            Session[]
  UserProgress       UserProgress[]
}

model UserProgress {
  id          String    @id
  userId      String
  milestoneId String
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  Milestone   Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  User        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, milestoneId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model WritingTopic {
  id          String     @id
  title       String
  slug        String     @unique
  description String
  content     String
  order       Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime
  Exercise    Exercise[]
}
